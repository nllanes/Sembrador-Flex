# ----------------------------------------------------------------------------
# flex-onboarding-manager - variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# ----------------------------------------------------------------------------

# Conexión a PostgreSQL (Docker). Para desarrollo local sin Docker usa SQLite:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg2://flex:flex@db:5432/flex_onboarding

# Credenciales usadas por el contenedor de PostgreSQL (docker-compose).
POSTGRES_USER=flex
POSTGRES_PASSWORD=flex
POSTGRES_DB=flex_onboarding

# Configuración de la app
APP_ENV=development
APP_TITLE=Flex Onboarding Manager
API_PREFIX=/api

# Clave para cifrar credenciales de buzón en reposo (Fernet).
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se deja vacía, en desarrollo se usa una clave efímera (no persistente).
CRED_KEY=

# Sembrado automático: Amazon.com (Playwright) + región en app Flex (Appium).
FLEX_CREATION_ENABLED=true
FLEX_CREATION_HEADLESS=true
FLEX_CREATION_TIMEOUT_MS=120000

FLEX_APPIUM_ENABLED=true
FLEX_APPIUM_SERVER_URL=http://127.0.0.1:4723
FLEX_APPIUM_DEVICE_NAME=Android Emulator
FLEX_APPIUM_NO_RESET=false
FLEX_APPIUM_TIMEOUT_S=180
FLEX_APP_PACKAGE=com.amazon.flex.rabbit
FLEX_APP_ACTIVITY=com.amazon.rabbit.android.presentation.core.LaunchActivity
FLEX_APP_APK_PATH=
FLEX_DEFAULT_VEHICLE_TYPE=Sedan

# Worker async. Local: true. Cloud: false y corre `python -m scripts.flex_worker`
FLEX_WORKER_EMBEDDED=true
FLEX_WORKER_POLL_SECONDS=2

# OTP por IMAP
# --- Si solo tienes dominio + forward a Gmail madre (tu caso típico Namecheap):
IMAP_OTP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MOTHER_EMAIL=tu_gmail_madre@gmail.com
IMAP_MOTHER_PASSWORD=xxxx-xxxx-xxxx-xxxx
# App Password: https://myaccount.google.com/apppasswords
#
# --- Si tienes Namecheap Private Email (buzón real por dirección):
# IMAP_HOST=mail.privateemail.com
# IMAP_MOTHER_EMAIL=
# IMAP_MOTHER_PASSWORD=
IMAP_OTP_TIMEOUT_S=300
IMAP_OTP_POLL_S=5
